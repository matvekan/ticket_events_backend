<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\User" table="users">
        <unique-constraints>
            <unique-constraint name="uniq_users_email" columns="email"/>
        </unique-constraints>

        <id name="id" type="uuid">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Symfony\Bridge\Doctrine\IdGenerator\UuidGenerator"/>
        </id>

        <field name="name" type="name" length="255"/>
        <field name="email" type="email" length="255"/>
        <field name="roles" type="json"/>
        <field name="password" length="255" nullable="true"/>
        <field name="resetPasswordTokenHash" column="reset_password_token_hash" length="64" nullable="true"/>
        <field name="resetPasswordTokenExpiresAt" column="reset_password_token_expires_at" type="datetime_immutable" nullable="true"/>

        <one-to-many field="orders" target-entity="App\Domain\Entity\Order" mapped-by="user"/>
    </entity>
</doctrine-mapping>
