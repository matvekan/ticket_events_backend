<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\ChatRoom" table="chat_rooms">
        <unique-constraints>
            <unique-constraint name="uniq_chat_rooms_user" columns="user_id"/>
        </unique-constraints>

        <id name="id" type="string" length="36">
            <generator strategy="NONE"/>
        </id>

        <one-to-one field="user" target-entity="App\Domain\Entity\User">
            <join-column name="user_id" nullable="false"/>
        </one-to-one>
        <field name="createdAt" type="datetime_immutable"/>

        <one-to-many field="messages" target-entity="App\Domain\Entity\ChatMessage" mapped-by="room" orphan-removal="true">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
