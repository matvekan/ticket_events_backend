<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Entity\OutboxMessage" table="messenger_outbox">
        <id name="id" type="string" length="36">
            <generator strategy="NONE"/>
        </id>
        <field name="messageClass" column="message_class" length="255"/>
        <field name="body" column="body" type="text"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="sentAt" column="sent_at" type="datetime_immutable" nullable="true"/>
        <field name="attempts" column="attempts" type="integer"/>
        <indexes>
            <index name="idx_outbox_pending" columns="sent_at,created_at"/>
        </indexes>
    </entity>
</doctrine-mapping>
