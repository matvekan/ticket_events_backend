<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\Payment" table="payments">
        <id name="id" type="payment_id">
            <generator strategy="NONE"/>
        </id>

        <!-- Cross-aggregate reference by ID only. -->
        <field name="orderId" column="order_id" type="order_id"/>

        <field name="amount" type="integer"/>
        <field name="status" type="string" enum-type="App\Domain\ValueObject\PaymentStatus" length="16"/>
        <field name="createdAt" type="datetime_immutable"/>
        <field name="paidAt" type="datetime_immutable" nullable="true"/>
        <field name="failedAt" type="datetime_immutable" nullable="true"/>

        <unique-constraints>
            <unique-constraint name="UNIQ_65D29B328D9F6D38" columns="order_id"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
