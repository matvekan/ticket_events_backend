<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\Payment" table="payments">
        <id name="id" type="string" length="36">
            <generator strategy="NONE"/>
        </id>

        <one-to-one field="order" target-entity="App\Domain\Entity\Order">
            <join-column name="order_id" nullable="false" unique="true"/>
        </one-to-one>

        <field name="amount" type="integer"/>
        <field name="status" type="string" enum-type="App\Domain\ValueObject\PaymentStatus" length="16"/>
        <field name="createdAt" type="datetime_immutable"/>
        <field name="paidAt" type="datetime_immutable" nullable="true"/>
        <field name="failedAt" type="datetime_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
