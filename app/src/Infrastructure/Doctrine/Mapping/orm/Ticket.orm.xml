<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\Ticket" table="tickets">
        <id name="id" type="string" length="36">
            <generator strategy="NONE"/>
        </id>

        <many-to-one field="order" target-entity="App\Domain\Entity\Order" inversed-by="tickets">
            <join-column name="order_id" nullable="false"/>
        </many-to-one>
        <one-to-one field="eventSeat" target-entity="App\Domain\Entity\EventSeat">
            <join-column name="event_seat_id" nullable="false" unique="true"/>
        </one-to-one>

        <field name="code" type="ticket_code" length="12" unique="true"/>
        <field name="status" type="string" enum-type="App\Domain\ValueObject\TicketStatus" length="20"/>
    </entity>
</doctrine-mapping>
