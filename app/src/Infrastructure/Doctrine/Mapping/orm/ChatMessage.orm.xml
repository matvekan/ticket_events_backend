<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\ChatMessage" table="chat_messages">
        <indexes>
            <index name="idx_chat_messages_room_created" columns="room_id,created_at"/>
        </indexes>

        <id name="id" type="chat_message_id">
            <generator strategy="NONE"/>
        </id>

        <!-- Cross-aggregate references by ID only. -->
        <field name="roomId" column="room_id" type="chat_room_id"/>
        <field name="senderId" column="sender_id" type="user_id"/>

        <field name="text" type="message_text"/>
        <field name="createdAt" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
