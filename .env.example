# Файл-пример. Скопируйте в .env и заполните своими значениями.
# docker-compose.yaml читает переменные окружения из .env через env_file.

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tickets_back?serverVersion=16&charset=utf8
ELASTICSEARCH_HOSTS=["http://elasticsearch:9200"]

POSTGRES_DB=tickets_back
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

CLICKHOUSE_USER=ticket_user
CLICKHOUSE_PASSWORD=ticket_pass

CHAT_WS_PORT=8080